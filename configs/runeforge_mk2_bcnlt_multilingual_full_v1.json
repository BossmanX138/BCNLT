{
  "schema_version": "bcnlt-multilingual-training-v1",
  "run_kind": "full",
  "languages": [
    "python", "javascript", "typescript", "c", "cpp", "c_sharp", "java",
    "go", "rust", "php", "ruby", "kotlin", "swift", "bash"
  ],
  "families": [
    "semantic_continuation", "semantic_to_code", "code_to_semantic",
