  "validation_interval_optimizer_steps": 500,
  "checkpoint_interval_optimizer_steps": 500,
  "maximum_optimizer_steps": null,
  "validation_examples_per_language": 256,
  "minimum_global_improvement": 0.02,
  "maximum_language_loss_ratio": 1.25
}
