# Python caches and local test state
__pycache__/
*.py[cod]
.pytest_cache/
.tmp-*/
.venv*/
venv/

# Generated corpus, audit, evaluation, and model artifacts
artifacts/
*.sqlite
*.sqlite-*
*.db
*.jsonl
*.log
*.tmp
*.part
*.pt
*.pth
*.bin
*.safetensors
*.gguf
*.onnx

# Imported evidence and immutable upstream snapshots remain on disk, but are
# represented in Git by the candidate lineage manifests rather than duplicated.
imports/

# Native/runtime payloads are reproducible dependencies, not source. Keep only
# the V10 runtime's Python source, sidecar, and manifest reviewable in Git.
vendor/*
!vendor/bcnlt_runtime_v10_learning_candidate/
vendor/bcnlt_runtime_v10_learning_candidate/*
!vendor/bcnlt_runtime_v10_learning_candidate/source/
!vendor/bcnlt_runtime_v10_learning_candidate/source/**
!vendor/bcnlt_runtime_v10_learning_candidate/bcnlt_source_sidecar.py
!vendor/bcnlt_runtime_v10_learning_candidate/runtime-manifest.json

# Native and packaged dependency payloads
*.dll
*.pyd
*.so
*.dylib
*.zip
*.tar
*.tar.gz
*.7z

# Editors and operating-system metadata
.vscode/
.idea/
.DS_Store
Thumbs.db
desktop.ini

# Re-apply cache exclusions after the selectively unignored vendor source tree.
**/__pycache__/
**/*.py[cod]

# A fresh checkout must contain the exact frozen tokenizer and parser runtime.
# Keep every other generated artifact and vendor payload ignored.
!artifacts/
artifacts/*
!artifacts/tokenizers/
artifacts/tokenizers/*
!artifacts/tokenizers/bcnlt-native-foundation-65536-v1/
!artifacts/tokenizers/bcnlt-native-foundation-65536-v1/**

# Small immutable parser fixtures are source-controlled test inputs.
!artifacts/bcnlt/
artifacts/bcnlt/*
!artifacts/bcnlt/multilingual-parser-output-v1/
!artifacts/bcnlt/multilingual-parser-output-v1/fixture-manifest.json
!artifacts/bcnlt/multilingual-parser-output-v1/real-output.jsonl

!vendor/tokenizers_runtime_0_23/
!vendor/tokenizers_runtime_0_23/**
!vendor/bcnlt_runtime_v10_learning_candidate/grammars/
!vendor/bcnlt_runtime_v10_learning_candidate/grammars/*.dll
!vendor/bcnlt_runtime_v10_learning_candidate/site-packages/
!vendor/bcnlt_runtime_v10_learning_candidate/site-packages/**

# Never capture generated bytecode from the newly included runtime trees.
**/__pycache__/
**/*.py[cod]
!vendor/tokenizers_runtime_0_23/tokenizers/tokenizers.pyd
!vendor/bcnlt_runtime_v10_learning_candidate/site-packages/**/*.pyd
